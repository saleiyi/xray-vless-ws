{
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 3000,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__XRAY_UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": { "path": "/ws" }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
